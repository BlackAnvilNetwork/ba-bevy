# Copy to gateway.local.env. That file is gitignored.
# Discord developer portal → OAuth2 → Redirects must list BA_DISCORD_REDIRECT_URI exactly.
# Authorization uses the code grant: https://discord.com/oauth2/authorize
# Token exchange uses HTTP Basic auth: https://discord.com/api/oauth2/token

BA_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
BA_GATEWAY_BIND=127.0.0.1:8790
BA_GATEWAY_PUBLIC_URL=http://127.0.0.1:8790
BA_DISCORD_REDIRECT_URI=http://127.0.0.1:17384/callback
BA_DISCORD_CLIENT_ID=
BA_DISCORD_CLIENT_SECRET=
