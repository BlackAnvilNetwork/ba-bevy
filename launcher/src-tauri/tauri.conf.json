{
  "build": {
    "beforeDevCommand": "npm run studio:dev",
    "beforeBuildCommand": "npm run studio:build",
    "devPath": "http://127.0.0.1:5173",
    "distDir": "../../character-studio/build",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Black Anvil Launcher",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Game",
      "copyright": "Black Anvil Network",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "network.blackanvil.launcher",
      "longDescription": "Black Anvil launcher — Character Studio host and game bootstrap.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "Black Anvil launcher",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Black Anvil — Launcher",
        "width": 1280
      }
    ]
  }
}
